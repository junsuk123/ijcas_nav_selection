+
+// IJCAS input adapter (input parsing only; the estimator is unchanged): the Isaac rig publishes
+// x y z intensity t, t = per-point offset from the scan start [s] (>= 0), no ring field.
+void Preprocess::ijcas_handler(const sensor_msgs::msg::PointCloud2::UniquePtr &msg)
+{
+  pl_surf.clear();
+  pl_corn.clear();
+  pl_full.clear();
+  pcl::PointCloud<ijcas_ros::Point> pl_orig;
+  pcl::fromROSMsg(*msg, pl_orig);
+  int plsize = pl_orig.points.size();
+  if (plsize == 0)
+    return;
+  pl_surf.reserve(plsize / std::max(point_filter_num, 1) + 1);
+  for (int i = 0; i < plsize; i++)
+  {
+    if (i % point_filter_num != 0)
+      continue;
+    const auto &p = pl_orig.points[i];
+    if (!std::isfinite(p.x) || !std::isfinite(p.y) || !std::isfinite(p.z))
+      continue;
+    if (p.x * p.x + p.y * p.y + p.z * p.z <= blind * blind)
+      continue;
+    PointType added_pt;
+    added_pt.normal_x = 0;
+    added_pt.normal_y = 0;
+    added_pt.normal_z = 0;
+    added_pt.x = p.x;
+    added_pt.y = p.y;
+    added_pt.z = p.z;
+    added_pt.intensity = p.intensity;
+    added_pt.curvature = p.time * time_unit_scale;  // curvature unit: ms
+    pl_surf.points.push_back(added_pt);
+  }
+}
